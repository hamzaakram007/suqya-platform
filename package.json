{
  "name": "suqya-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Water Tanker Ordering Platform — Saudi Arabia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @suqya/api",
    "dev:admin": "npm run dev -w @suqya/admin-web",
    "dev:supplier": "npm run dev -w @suqya/supplier-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @suqya/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @suqya/api",
    "db:generate": "npm run db:generate -w @suqya/api",
    "db:seed": "npm run db:seed -w @suqya/api",
    "db:seed:pilot": "npm run db:seed:pilot -w @suqya/api",
    "smoke:staging": "bash scripts/smoke-staging.sh",
    "smoke:tracking": "bash scripts/smoke-tracking.sh",
    "e2e:foundation": "bash scripts/e2e-foundation.sh",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/local-setup.ps1",
    "render:k8s": "powershell -ExecutionPolicy Bypass -File scripts/render-k8s.ps1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
