# syntax=docker/dockerfile:1.6
# Multi-stage NestJS API (+ optional BullMQ worker via WORKER_MODE=true)
FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/ ./packages/

RUN npm ci --workspace=@suqya/api --include-workspace-root

COPY apps/api/ ./apps/api/

RUN npm run build -w @suqya/api \
  && npx prisma generate --schema=apps/api/prisma/schema.prisma

FROM node:20-alpine AS runtime
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat curl \
  && addgroup -S suqya && adduser -S suqya -G suqya

ENV NODE_ENV=production \
    PORT=4000 \
    PRISMA_SCHEMA=prisma/schema.prisma

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/prisma ./prisma
COPY --from=builder /app/node_modules ./node_modules
COPY infra/docker/docker-entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh \
  && chown -R suqya:suqya /app

USER suqya
EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/v1/health" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
