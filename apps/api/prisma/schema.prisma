generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy ───────────────────────────────────────────

enum TenantMode {
  marketplace
  private
  franchise
}

enum TenantStatus {
  active
  suspended
  trial
}

model Tenant {
  id              String       @id @default(uuid())
  name            String
  nameAr          String?      @map("name_ar")
  nameEn          String?      @map("name_en")
  mode            TenantMode   @default(marketplace)
  parentTenantId  String?      @map("parent_tenant_id")
  status          TenantStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  parentTenant Tenant?  @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants Tenant[] @relation("TenantHierarchy")

  settings     TenantSetting[]
  branches     Branch[]
  users        User[]
  roles        Role[]
  suppliers    Supplier[]
  drivers      Driver[]
  orders       Order[]
  pricingRules PricingRule[]
  coupons      Coupon[]
  creditAccounts CreditAccount[]
  invoices     Invoice[]
  journalEntries JournalEntry[]
  chartOfAccounts ChartOfAccount[]
  deliveryZones DeliveryZone[]
  tankSizes    TankSize[]
  supportTickets SupportTicket[]
  auditLogs    AuditLog[]
  settlements  Settlement[]
  faqs         Faq[]

  @@map("tenants")
}

model TenantSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  key      String
  value    Json

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  nameAr    String?  @map("name_ar")
  nameEn    String?  @map("name_en")
  cityId    String?  @map("city_id")
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  city   City?  @relation(fields: [cityId], references: [id])

  @@map("branches")
}

// ─── Identity & Access ───────────────────────────────────────

enum UserRole {
  customer
  driver
  supplier
  admin
  dispatcher
}

enum UserStatus {
  active
  inactive
  suspended
  pending_verification
}

model User {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  phone     String
  email     String?
  role      UserRole
  status    UserStatus @default(pending_verification)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  profile  UserProfile?
  sessions Session[]
  devices  Device[]
  addresses Address[]
  orders   Order[]       @relation("CustomerOrders")
  wallet   Wallet?
  creditAccount CreditAccount?
  userRoles UserRoleAssignment[]
  notifications Notification[]
  supportTickets SupportTicket[]
  ratingsGiven Rating[] @relation("RaterRatings")
  supplierProfile Supplier?
  driverProfile Driver?

  @@unique([tenantId, phone])
  @@index([tenantId, role])
  @@map("users")
}

model UserProfile {
  id                String  @id @default(uuid())
  userId            String  @unique @map("user_id")
  nameAr            String? @map("name_ar")
  nameEn            String? @map("name_en")
  nationalId        String? @map("national_id")
  companyName       String? @map("company_name")
  preferredLanguage String  @default("ar") @map("preferred_language")
  avatarUrl         String? @map("avatar_url")
  customerType      String? @map("customer_type")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String
  slug     String

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  slug        String @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  /// SHA-256 hex of the opaque refresh token (indexed unique lookup — not bcrypt).
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceId         String?   @map("device_id")
  expiresAt        DateTime  @map("expires_at")
  /// Set when rotated or force-revoked. Presenting a revoked token triggers reuse lockdown.
  revokedAt        DateTime? @map("revoked_at")
  replacedById     String?   @map("replaced_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Device {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  fcmToken   String?   @map("fcm_token")
  platform   String?
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model OtpCode {
  id             String   @id @default(uuid())
  tenantId       String?  @map("tenant_id")
  phone          String
  code           String
  expiresAt      DateTime @map("expires_at")
  used           Boolean  @default(false)
  failedAttempts Int      @default(0) @map("failed_attempts")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([phone, code, tenantId])
  @@index([phone, tenantId, createdAt])
  @@map("otp_codes")
}

// ─── Geography ─────────────────────────────────────────────

model Country {
  id     String @id @default(uuid())
  code   String @unique
  nameAr String @map("name_ar")
  nameEn String @map("name_en")

  regions Region[]

  @@map("countries")
}

model Region {
  id        String @id @default(uuid())
  countryId String @map("country_id")
  nameAr    String @map("name_ar")
  nameEn    String @map("name_en")

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@map("regions")
}

model City {
  id       String @id @default(uuid())
  regionId String @map("region_id")
  nameAr   String @map("name_ar")
  nameEn   String @map("name_en")

  region        Region         @relation(fields: [regionId], references: [id])
  districts     District[]
  branches      Branch[]
  addresses     Address[]
  deliveryZones DeliveryZone[]

  @@map("cities")
}

model District {
  id     String @id @default(uuid())
  cityId String @map("city_id")
  nameAr String @map("name_ar")
  nameEn String @map("name_en")

  city      City      @relation(fields: [cityId], references: [id])
  addresses Address[]

  @@map("districts")
}

model DeliveryZone {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  name     String
  nameAr   String? @map("name_ar")
  nameEn   String? @map("name_en")
  cityId   String  @map("city_id")
  boundary Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  city   City   @relation(fields: [cityId], references: [id])

  @@map("delivery_zones")
}

model Address {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  label          String?
  buildingNumber String? @map("building_number")
  street         String?
  districtId     String? @map("district_id")
  cityId         String? @map("city_id")
  postalCode     String? @map("postal_code")
  shortAddress   String? @map("short_address")
  latitude       Float?
  longitude      Float?
  instructions   String?
  isDefault      Boolean @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  orders   Order[]

  @@map("addresses")
}

// ─── Catalog ───────────────────────────────────────────────

model TankSize {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  capacityLiters Int     @map("capacity_liters")
  nameAr         String  @map("name_ar")
  nameEn         String  @map("name_en")
  isActive       Boolean @default(true) @map("is_active")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("tank_sizes")
}

model WaterType {
  id        String  @id @default(uuid())
  nameAr    String  @map("name_ar")
  nameEn    String  @map("name_en")
  isPotable Boolean @default(true) @map("is_potable")

  waterSources WaterSource[]

  @@map("water_types")
}

// ─── Fleet ───────────────────────────────────────────────────

enum SupplierStatus {
  pending
  active
  suspended
  rejected
}

model Supplier {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  userId                String         @unique @map("user_id")
  companyName           String         @map("company_name")
  ownerName             String?        @map("owner_name")
  commercialRegistration String?       @map("commercial_registration")
  vatNumber             String?        @map("vat_number")
  status                SupplierStatus @default(pending)
  latitude              Float?
  longitude             Float?
  workingHoursStart     String?        @map("working_hours_start")
  workingHoursEnd       String?        @map("working_hours_end")
  commissionRate        Decimal        @default(10) @db.Decimal(5, 2)
  createdAt             DateTime       @default(now()) @map("created_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  documents SupplierDocument[]
  trucks    Truck[]
  drivers   Driver[]
  waterSources WaterSource[]
  orders    Order[]
  settlements Settlement[]

  @@map("suppliers")
}

model SupplierDocument {
  id          String    @id @default(uuid())
  supplierId  String    @map("supplier_id")
  type        String
  documentUrl String    @map("document_url")
  expiresAt   DateTime? @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_documents")
}

model WaterSource {
  id           String @id @default(uuid())
  supplierId   String @map("supplier_id")
  name         String
  waterTypeId  String @map("water_type_id")
  latitude     Float?
  longitude    Float?

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  waterType   WaterType            @relation(fields: [waterTypeId], references: [id])
  certificates QualityCertificate[]

  @@map("water_sources")
}

model QualityCertificate {
  id            String   @id @default(uuid())
  waterSourceId String   @map("water_source_id")
  documentUrl   String   @map("document_url")
  issuedAt      DateTime @map("issued_at")
  expiresAt     DateTime @map("expires_at")

  waterSource WaterSource @relation(fields: [waterSourceId], references: [id], onDelete: Cascade)

  @@map("quality_certificates")
}

enum TruckStatus {
  active
  maintenance
  inactive
}

model Truck {
  id             String      @id @default(uuid())
  supplierId     String      @map("supplier_id")
  plateNumber    String      @map("plate_number")
  capacityLiters Int         @map("capacity_liters")
  status         TruckStatus @default(active)
  createdAt      DateTime    @default(now()) @map("created_at")

  supplier    Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  maintenance TruckMaintenance[]
  drivers     Driver[]

  @@map("trucks")
}

model TruckMaintenance {
  id          String    @id @default(uuid())
  truckId     String    @map("truck_id")
  type        String
  scheduledAt DateTime  @map("scheduled_at")
  completedAt DateTime? @map("completed_at")
  cost        Decimal?  @db.Decimal(12, 2)
  notes       String?

  truck Truck @relation(fields: [truckId], references: [id], onDelete: Cascade)

  @@map("truck_maintenance")
}

enum DriverStatus {
  active
  inactive
  suspended
}

model Driver {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  userId           String       @unique @map("user_id")
  supplierId       String       @map("supplier_id")
  truckId          String?      @map("truck_id")
  licenseNumber    String?      @map("license_number")
  status           DriverStatus @default(active)
  isOnline         Boolean      @default(false) @map("is_online")
  latitude         Float?
  longitude        Float?
  performanceScore Decimal      @default(5.0) @map("performance_score") @db.Decimal(3, 1)
  compensationType String       @default("per_trip") @map("compensation_type")
  createdAt        DateTime     @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  user        User             @relation(fields: [userId], references: [id])
  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  truck       Truck?           @relation(fields: [truckId], references: [id])
  documents   DriverDocument[]
  shifts      DriverShift[]
  locations   DriverLocation[]
  orders      Order[]
  assignments OrderAssignment[]
  earnings    DriverEarning[]

  @@index([tenantId, isOnline])
  @@map("drivers")
}

model DriverDocument {
  id          String    @id @default(uuid())
  driverId    String    @map("driver_id")
  type        String
  documentUrl String    @map("document_url")
  expiresAt   DateTime? @map("expires_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_documents")
}

model DriverShift {
  id        String    @id @default(uuid())
  driverId  String    @map("driver_id")
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_shifts")
}

model DriverLocation {
  id         String   @id @default(uuid())
  driverId   String   @map("driver_id")
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt(sort: Desc)])
  @@map("driver_locations")
}

model DriverEarning {
  id        String   @id @default(uuid())
  driverId  String   @map("driver_id")
  orderId   String?  @map("order_id")
  amount    Decimal  @db.Decimal(12, 2)
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_earnings")
}

// ─── Pricing ───────────────────────────────────────────────

model PricingRule {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  name      String
  ruleType  String  @map("rule_type")
  basePrice Decimal @map("base_price") @db.Decimal(12, 2)
  isActive  Boolean @default(true) @map("is_active")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conditions PricingRuleCondition[]

  @@map("pricing_rules")
}

model PricingRuleCondition {
  id             String @id @default(uuid())
  pricingRuleId  String @map("pricing_rule_id")
  conditionType  String @map("condition_type")
  conditionValue Json   @map("condition_value")

  pricingRule PricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@map("pricing_rule_conditions")
}

model Coupon {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  code          String
  titleAr       String?   @map("title_ar")
  titleEn       String?   @map("title_en")
  descriptionAr String?   @map("description_ar")
  descriptionEn String?   @map("description_en")
  discountType  String    @map("discount_type")
  discountValue Decimal   @map("discount_value") @db.Decimal(12, 2)
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  expiresAt     DateTime? @map("expires_at")
  isActive      Boolean   @default(true) @map("is_active")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupons")
}

// ─── Orders ──────────────────────────────────────────────────

enum OrderStatus {
  pending
  supplier_review
  dispatching
  driver_offered
  accepted
  filling
  in_transit
  delivered
  payment_pending
  completed
  cancelled
  disputed
}

enum PaymentType {
  cash
  card
  credit
  wallet
  split
}

enum SlaType {
  standard
  emergency
  scheduled
}

model Order {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  orderNumber  String      @map("order_number")
  customerId   String      @map("customer_id")
  supplierId   String?     @map("supplier_id")
  driverId     String?     @map("driver_id")
  addressId    String      @map("address_id")
  tankSizeId   String      @map("tank_size_id")
  status       OrderStatus @default(pending)
  paymentType  PaymentType @map("payment_type")
  subtotal     Decimal     @db.Decimal(12, 2)
  vatAmount    Decimal     @default(0) @map("vat_amount") @db.Decimal(12, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  slaType      SlaType     @default(standard) @map("sla_type")
  scheduledAt  DateTime?   @map("scheduled_at")
  completedAt  DateTime?   @map("completed_at")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer User      @relation("CustomerOrders", fields: [customerId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  address  Address   @relation(fields: [addressId], references: [id])
  tankSize TankSize  @relation(fields: [tankSizeId], references: [id])

  statusHistory OrderStatusHistory[]
  assignments   OrderAssignment[]
  trackingPoints OrderTrackingPoint[]
  proofOfDelivery ProofOfDelivery?
  dispute       OrderDispute?
  transactions  Transaction[]
  invoices      Invoice[]
  ratings       Rating[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  actorId   String?     @map("actor_id")
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model OrderAssignment {
  id          String    @id @default(uuid())
  orderId     String    @map("order_id")
  driverId    String    @map("driver_id")
  offeredAt   DateTime  @default(now()) @map("offered_at")
  respondedAt DateTime? @map("responded_at")
  response    String?

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id])

  @@map("order_assignments")
}

model OrderTrackingPoint {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_tracking_points")
}

model ProofOfDelivery {
  id          String   @id @default(uuid())
  orderId     String   @unique @map("order_id")
  photoUrl    String?  @map("photo_url")
  signatureUrl String? @map("signature_url")
  otpVerified Boolean  @default(false) @map("otp_verified")
  deliveredAt DateTime @default(now()) @map("delivered_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("proof_of_delivery")
}

model OrderDispute {
  id         String @id @default(uuid())
  orderId    String @unique @map("order_id")
  raisedBy   String @map("raised_by")
  reason     String
  status     String @default("open")
  resolution String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_disputes")
}

// ─── Payments & Credit ───────────────────────────────────────

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

model Transaction {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  orderId    String?           @map("order_id")
  amount     Decimal           @db.Decimal(12, 2)
  method     String
  status     TransactionStatus @default(pending)
  gatewayRef String?           @map("gateway_ref")
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  order Order? @relation(fields: [orderId], references: [id])
  splits PaymentSplit[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("transactions")
}

model PaymentSplit {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  method        String
  amount        Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment_splits")
}

model Wallet {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  balance  Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("SAR")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger WalletLedger[]

  @@map("wallets")
}

model WalletLedger {
  id          String   @id @default(uuid())
  walletId    String   @map("wallet_id")
  amount      Decimal  @db.Decimal(12, 2)
  type        String
  referenceId String?  @map("reference_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_ledger")
}

enum CreditAccountStatus {
  pending
  approved
  suspended
  closed
}

model CreditAccount {
  id                 String              @id @default(uuid())
  tenantId           String              @map("tenant_id")
  customerId         String              @unique @map("customer_id")
  creditLimit        Decimal             @map("credit_limit") @db.Decimal(12, 2)
  outstandingBalance Decimal             @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  status             CreditAccountStatus @default(pending)
  approvedBy         String?             @map("approved_by")
  approvedAt         DateTime?           @map("approved_at")
  createdAt          DateTime            @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  customer     User                @relation(fields: [customerId], references: [id])
  transactions CreditTransaction[]
  reminders    PaymentReminder[]

  @@index([tenantId, status])
  @@map("credit_accounts")
}

model CreditTransaction {
  id              String   @id @default(uuid())
  creditAccountId String   @map("credit_account_id")
  amount          Decimal  @db.Decimal(12, 2)
  type            String
  dueDate         DateTime? @map("due_date")
  paidAt          DateTime? @map("paid_at")
  orderId         String?  @map("order_id")
  createdAt       DateTime @default(now()) @map("created_at")

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

model PaymentReminder {
  id              String   @id @default(uuid())
  creditAccountId String   @map("credit_account_id")
  channel         String
  sentAt          DateTime @default(now()) @map("sent_at")
  dueDate         DateTime @map("due_date")

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@map("payment_reminders")
}

// ─── Billing & Accounting ────────────────────────────────────

enum InvoiceType {
  standard
  simplified
  credit_note
  debit_note
}

enum ZatcaStatus {
  pending
  submitted
  cleared
  rejected
}

model Invoice {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  orderId       String?     @map("order_id")
  invoiceNumber String      @map("invoice_number")
  type          InvoiceType @default(simplified)
  subtotal      Decimal     @db.Decimal(12, 2)
  vatAmount     Decimal     @map("vat_amount") @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  zatcaStatus   ZatcaStatus @default(pending) @map("zatca_status")
  pdfUrl        String?     @map("pdf_url")
  issuedAt      DateTime    @default(now()) @map("issued_at")

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  order       Order?                  @relation(fields: [orderId], references: [id])
  lines       InvoiceLine[]
  zatcaSubmission InvoiceZatcaSubmission?

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  vatRate     Decimal @default(15) @map("vat_rate") @db.Decimal(5, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model InvoiceZatcaSubmission {
  id             String   @id @default(uuid())
  invoiceId      String   @unique @map("invoice_id")
  submissionType String   @map("submission_type")
  zatcaUuid      String?  @map("zatca_uuid")
  qrCode         String?  @map("qr_code")
  response       Json?
  submittedAt    DateTime @default(now()) @map("submitted_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_zatca_submissions")
}

model ChartOfAccount {
  id          String @id @default(uuid())
  tenantId    String @map("tenant_id")
  code        String
  nameAr      String @map("name_ar")
  nameEn      String @map("name_en")
  accountType String @map("account_type")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  referenceType String   @map("reference_type")
  referenceId   String?  @map("reference_id")
  description   String?
  postedAt      DateTime @default(now()) @map("posted_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  lines  JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(uuid())
  journalEntryId String  @map("journal_entry_id")
  accountId      String  @map("account_id")
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

model Settlement {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  supplierId String   @map("supplier_id")
  periodStart DateTime @map("period_start")
  periodEnd  DateTime @map("period_end")
  grossAmount Decimal @map("gross_amount") @db.Decimal(12, 2)
  commission Decimal  @db.Decimal(12, 2)
  netAmount  Decimal  @map("net_amount") @db.Decimal(12, 2)
  status     String   @default("pending")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@map("settlements")
}

// ─── Operations ────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  channel   String
  title     String
  body      String
  /// Template event key — display title/body resolved from NotificationTemplate by locale at read time
  eventKey  String?   @map("event_key")
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Faq {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  questionAr String   @map("question_ar")
  questionEn String   @map("question_en")
  answerAr   String   @map("answer_ar")
  answerEn   String   @map("answer_en")
  category   String   @default("general")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category, sortOrder])
  @@map("faqs")
}

model NotificationTemplate {
  id       String @id @default(uuid())
  tenantId String? @map("tenant_id")
  event    String
  channel  String
  titleAr  String @map("title_ar")
  titleEn  String @map("title_en")
  bodyAr   String @map("body_ar")
  bodyEn   String @map("body_en")

  @@unique([event, channel])
  @@map("notification_templates")
}

model SupportTicket {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  subject   String
  status    String   @default("open")
  priority  String   @default("normal")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id       String   @id @default(uuid())
  ticketId String   @map("ticket_id")
  senderId String   @map("sender_id")
  body     String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model Rating {
  id       String  @id @default(uuid())
  orderId  String  @map("order_id")
  raterId  String  @map("rater_id")
  ratedId  String  @map("rated_id")
  score    Int
  comment  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rater User  @relation("RaterRatings", fields: [raterId], references: [id])

  @@map("ratings")
}

model RecurringOrder {
  id              String    @id @default(uuid())
  customerId      String    @map("customer_id")
  tankSizeId      String    @map("tank_size_id")
  addressId       String    @map("address_id")
  frequency       String
  nextDeliveryAt  DateTime  @map("next_delivery_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("recurring_orders")
}

model LoyaltyPoint {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  points     Int
  type       String
  referenceId String? @map("reference_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("loyalty_points")
}

// ─── Enterprise Extensions (Phase 14) ───────────────────────

model SubscriptionPlan {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  name         String
  nameAr       String? @map("name_ar")
  nameEn       String? @map("name_en")
  priceMonthly Decimal @map("price_monthly") @db.Decimal(12, 2)
  deliveriesPerMonth Int @map("deliveries_per_month")
  isActive     Boolean @default(true) @map("is_active")

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  planId           String   @map("plan_id")
  status           String   @default("active")
  currentPeriodEnd DateTime @map("current_period_end")
  createdAt        DateTime @default(now()) @map("created_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("user_subscriptions")
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String   @map("referrer_id")
  referredPhone String   @map("referred_phone")
  status        String   @default("pending")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("referrals")
}

model FuelExpense {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  supplierId String   @map("supplier_id")
  truckId    String?  @map("truck_id")
  liters     Decimal  @db.Decimal(10, 2)
  cost       Decimal  @db.Decimal(12, 2)
  odometer   Int?
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@map("fuel_expenses")
}

model InventoryItem {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  supplierId String  @map("supplier_id")
  name       String
  sku        String
  quantity   Int     @default(0)
  unit       String  @default("pcs")

  @@unique([tenantId, supplierId, sku])
  @@map("inventory_items")
}

model Employee {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  supplierId String  @map("supplier_id")
  name       String
  role       String
  phone      String?
  nationalId String? @map("national_id")
  isActive   Boolean @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("employees")
}

model FraudAlert {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  alertType  String   @map("alert_type")
  message    String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, resolved])
  @@map("fraud_alerts")
}
