# Local Compose maps host ports 5433 (Postgres) and 6380 (Redis).
# Inside containers use 5432 / 6379 and hostnames postgres / redis.
DATABASE_URL="postgresql://suqya:suqya_dev@localhost:5433/suqya?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6380
# Optional PaaS form (Railway / Upstash). When set, overrides REDIS_HOST/PORT.
# REDIS_URL=redis://default:password@host:6379
JWT_SECRET=suqya-dev-secret-change-in-production
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# Foundation sandbox toggles (honest E2E without live vendor keys)
# OTP_MODE=auto|sandbox|live — auto uses fixed code outside production / when SMS is sandbox
OTP_MODE=sandbox
OTP_SANDBOX_CODE=123456
OTP_EXPOSE_IN_RESPONSE=true
SMS_PROVIDER=auto
# UNIFONIC_APP_SID=
# UNIFONIC_API_URL=https://el.cloud.unifonic.com/rest/SMS/messages
# UNIFONIC_SENDER_ID=Suqya
PAYMENT_MODE=sandbox
POD_MODE=sandbox
PUSH_PROVIDER=sandbox
NOTIFICATION_INLINE=true

# Moyasar (real test keys from https://moyasar.com — leave placeholder to keep PAYMENT_MODE sandbox)
MOYASAR_PUBLISHABLE_KEY=pk_test_placeholder
MOYASAR_SECRET_KEY=sk_test_placeholder
MOYASAR_WEBHOOK_SECRET=whsec_placeholder

# ZATCA Fatoora sandbox (TLV QR always generated locally; HTTP submit only if URL set)
ZATCA_ENV=sandbox
ZATCA_SANDBOX_URL=
ZATCA_API_TOKEN=
ZATCA_VAT_NUMBER=300000000000003
# FCM_SERVER_KEY=
