# Copy to apps/api/.env.staging for docker-compose.staging.yml,
# or set the same keys on Railway (Variables) / Fly / Render.
#
# Never commit real values. Names only below — owner supplies secrets.

NODE_ENV=production
PORT=4000

# Railway Postgres plugin injects DATABASE_URL automatically when linked.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/suqya?schema=public

# Prefer REDIS_URL from Railway Redis / Upstash. Falls back to host/port.
REDIS_URL=redis://default:PASSWORD@HOST:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Required — openssl rand -base64 48 (≠ production; min 32 chars; not a known default).
# API refuses to boot if missing/weak when NODE_ENV=production or APP_ENV=staging.
JWT_SECRET=
# APP_ENV=staging
# During rotation only (remove after access-token TTL elapses):
# JWT_SECRET_PREVIOUS=

# Include every web origin that will call the API (no trailing slash).
CORS_ORIGINS=https://admin-web-psi-sepia.vercel.app,https://supplier-web-one.vercel.app

PAYMENT_CALLBACK_URL=https://admin-web-psi-sepia.vercel.app/payment/callback

# Foundation path — keep sandbox OTP/payment until live Unifonic/Moyasar keys exist.
# sandboxCode is returned only because OTP_MODE=sandbox AND OTP_EXPOSE_IN_RESPONSE=true.
# Set OTP_EXPOSE_IN_RESPONSE=false before any shared/public staging audience.
# OTP_MODE=live ONLY when UNIFONIC_APP_SID is set (see docs/deployment/vendor-keys-staging.md).
OTP_MODE=sandbox
OTP_SANDBOX_CODE=123456
OTP_EXPOSE_IN_RESPONSE=true
SMS_PROVIDER=auto
# UNIFONIC_APP_SID=
# UNIFONIC_SENDER_ID=Suqya
# UNIFONIC_API_URL=https://el.cloud.unifonic.com/rest/SMS/messages
PAYMENT_MODE=sandbox
POD_MODE=sandbox
PUSH_PROVIDER=sandbox
NOTIFICATION_INLINE=true

# Sandbox payment / tax — optional for health + auth smoke.
# Replace placeholders with real pk_test_/sk_test_ (or live) from Moyasar dashboard.
# Moyasar webhook URL for this staging host:
#   https://api-production-e8c4a.up.railway.app/v1/payments/webhook
MOYASAR_PUBLISHABLE_KEY=pk_test_placeholder
MOYASAR_SECRET_KEY=sk_test_placeholder
MOYASAR_WEBHOOK_SECRET=whsec_placeholder
ZATCA_ENV=sandbox
ZATCA_SANDBOX_URL=
ZATCA_API_TOKEN=
ZATCA_VAT_NUMBER=300000000000003

# Entrypoint toggles (Compose / custom hosts). Railway uses releaseCommand for migrate.
RUN_MIGRATIONS=true
RUN_SEED=true
WORKER_MODE=false

# Maps — client-side only (Flutter dart-define / Vercel NEXT_PUBLIC_*).
# API only fans out Socket.io GPS on /tracking — no server Maps key required.
# Flutter: copy apps/*/dart_defines.staging.example.json → dart_defines.staging.json
#   GOOGLE_MAPS_API_KEY + MAPS_MODE=google|sandbox|auto
# Android Manifest still has REPLACE_WITH_RESTRICTED_ANDROID_KEY until owner embeds a restricted key.
# MAPS_MODE=sandbox
# GOOGLE_MAPS_API_KEY=

