# Copy to apps/api/.env.staging for docker-compose.staging.yml,
# or set the same keys on Railway (Variables) / Fly / Render.
#
# Never commit real values. Names only below — owner supplies secrets.

NODE_ENV=production
PORT=4000

# Railway Postgres plugin injects DATABASE_URL automatically when linked.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/suqya?schema=public

# Prefer REDIS_URL from Railway Redis / Upstash. Falls back to host/port.
REDIS_URL=redis://default:PASSWORD@HOST:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Required — generate a long random string for staging (≠ production).
JWT_SECRET=

# Include every web origin that will call the API (no trailing slash).
CORS_ORIGINS=https://admin-web-psi-sepia.vercel.app,https://supplier-web-one.vercel.app

PAYMENT_CALLBACK_URL=https://admin-web-psi-sepia.vercel.app/payment/callback

# Sandbox payment / tax — optional for health + auth smoke.
MOYASAR_PUBLISHABLE_KEY=pk_test_placeholder
MOYASAR_SECRET_KEY=sk_test_placeholder
MOYASAR_WEBHOOK_SECRET=whsec_placeholder
ZATCA_ENV=sandbox
ZATCA_SANDBOX_URL=
ZATCA_API_TOKEN=
ZATCA_VAT_NUMBER=300000000000003

# Entrypoint toggles (Compose / custom hosts). Railway uses releaseCommand for migrate.
RUN_MIGRATIONS=true
RUN_SEED=true
WORKER_MODE=false
