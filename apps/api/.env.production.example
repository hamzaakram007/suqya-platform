# Production API env — names only. Copy values into Railway (or Secrets Manager).
# Never commit real secrets. Prefer a dedicated Railway project: suqya-production.
#
# Staging twin: .env.staging.example · Runbook: docs/deployment/publish-surfaces.md

NODE_ENV=production
PORT=4000
# APP_ENV=production

# Injected by Railway Postgres / Redis plugins when linked:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/suqya?schema=public
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Required — openssl rand -base64 48 — MUST differ from staging.
# API refuses to boot if missing/weak when NODE_ENV=production.
JWT_SECRET=
# During rotation only (remove after access-token TTL elapses):
# JWT_SECRET_PREVIOUS=

# Every browser origin that calls the API (no trailing slash).
CORS_ORIGINS=https://admin-web-psi-sepia.vercel.app,https://supplier-web-one.vercel.app

PAYMENT_CALLBACK_URL=https://admin-web-psi-sepia.vercel.app/payment/callback

# Production auth — never expose OTP codes.
OTP_MODE=live
OTP_EXPOSE_IN_RESPONSE=false
SMS_PROVIDER=unifonic
# UNIFONIC_APP_SID=

# Flip to live only with real Moyasar dashboard keys + webhook.
PAYMENT_MODE=live
MOYASAR_PUBLISHABLE_KEY=pk_live_REPLACE
MOYASAR_SECRET_KEY=sk_live_REPLACE
MOYASAR_WEBHOOK_SECRET=whsec_REPLACE

# Keep sandbox until certified EGS / Fatoora prod credentials exist.
ZATCA_ENV=sandbox
# ZATCA_ENV=production
ZATCA_SANDBOX_URL=
ZATCA_API_TOKEN=
ZATCA_VAT_NUMBER=

POD_MODE=live
PUSH_PROVIDER=fcm
# FCM_SERVER_KEY=
NOTIFICATION_INLINE=false
WORKER_MODE=false

# Client-side Maps keys live in Flutter dart-defines / Vercel NEXT_PUBLIC_*.
# GOOGLE_MAPS_API_KEY=
